    <!-- http://www.fbk.eu/ontologies/virtualcoach#ComposedFood -->

    <owl:Class rdf:about="http://www.fbk.eu/ontologies/virtualcoach#ComposedFood">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#contains"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#BasicFood"/>
                                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Dressing"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="it">Alimento Composto</rdfs:label>
        <rdfs:label xml:lang="en">Composed Food</rdfs:label>
    </owl:Class>
    


