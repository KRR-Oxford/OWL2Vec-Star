<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.fbk.eu/ontologies/virtualcoach#"
     xml:base="http://www.fbk.eu/ontologies/virtualcoach"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vc="http://www.fbk.eu/ontologies/virtualcoach#">
    <owl:Ontology rdf:about="http://www.fbk.eu/ontologies/virtualcoach"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#activeCategory -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#activeCategory"/>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#appliesTo -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#appliesTo"/>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#command -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#command">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#foodId -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#foodId">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasForbiddenCategory -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasForbiddenCategory">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Profile"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasMandatoryCategory -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasMandatoryCategory">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Profile"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasMonitoredValue -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasMonitoredValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasMonitoredValueInterval -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasMonitoredValueInterval">
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#ValueInterval"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasOperator -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasOperator">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasPriority -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasPriority">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasRuleId -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasRuleId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#id -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#id"/>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#interfaceLabel -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#interfaceLabel">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#isRecipeConsumedFood -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#isRecipeConsumedFood"/>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#isUnspecifiedFood -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#isUnspecifiedFood"/>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#lowerBound -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#lowerBound">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#monitoredEntity -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#monitoredEntity">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#monitoredEntityType -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#monitoredEntityType">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#productCategory -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#productCategory">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#timing -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#timing">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#upperBound -->

    <owl:AnnotationProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#upperBound">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#belongsProfile -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#belongsProfile">
        <owl:inverseOf rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#containsUser"/>
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#User"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Profile"/>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#consumed -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#consumed">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#User"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
        <rdfs:label xml:lang="en">consumed</rdfs:label>
        <rdfs:label xml:lang="it">ha consumato</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#contains -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#contains">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
        <rdfs:label xml:lang="en">contains</rdfs:label>
        <rdfs:label xml:lang="it">contiene</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#containsUser -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#containsUser">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Profile"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#User"/>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasActivity -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasActivity">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#EffortCaloriesEquivalent"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#PerformedActivity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Activity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasConsumedFood -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasConsumedFood">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#ConsumedFood"/>
        <rdfs:label xml:lang="it">ha Consumato Cibo</rdfs:label>
        <rdfs:label xml:lang="en">has Consumed Food</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasFood -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasFood">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#ConsumedFood"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#EffortCaloriesEquivalent"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#RecipeFood"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
        <rdfs:label xml:lang="it">ha Cibo</rdfs:label>
        <rdfs:label xml:lang="en">has Food</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasNutrient -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasNutrient">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Nutrient"/>
        <rdfs:label xml:lang="it">ha Nutriente</rdfs:label>
        <rdfs:label xml:lang="en">has Nutrient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasRecipeFood -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasRecipeFood">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Recipe"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#RecipeFood"/>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasUser -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasUser">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#PerformedActivity"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#User"/>
        <rdfs:label xml:lang="it">ha Utente</rdfs:label>
        <rdfs:label xml:lang="en">has User</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasViolationMeal -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasViolationMeal">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Violation"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasViolationRule -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasViolationRule">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Violation"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasViolationUser -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasViolationUser">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Violation"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#User"/>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#monitor -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#monitor">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#MonitoringRule"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#User"/>
    </owl:ObjectProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#performed -->

    <owl:ObjectProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#performed">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#User"/>
        <rdfs:range rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#PerformedActivity"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#activityDuration -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#activityDuration">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#EffortCaloriesEquivalent"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#PerformedActivity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#activityEndTimestamp -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#activityEndTimestamp">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#PerformedActivity"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#activityStartTimestamp -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#activityStartTimestamp">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#PerformedActivity"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#amountCalories -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#amountCalories">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">amount of Calories</rdfs:label>
        <rdfs:label xml:lang="it">quantita&apos; Calorie</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#amountEnergy -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#amountEnergy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">amount of Energy</rdfs:label>
        <rdfs:label xml:lang="it">quantita&apos; Energia</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#amountFood -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#amountFood">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#ConsumedFood"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#EffortCaloriesEquivalent"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Recipe"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#RecipeFood"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">amount of Food</rdfs:label>
        <rdfs:label xml:lang="it">quantita&apos; Cibo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#amountNutrient -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#amountNutrient">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Nutrient"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">amount of Nutrient</rdfs:label>
        <rdfs:label xml:lang="it">quantita&apos; Nutriente</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#amountWater -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#amountWater">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
                    <rdf:Description rdf:about="http://www.fbk.eu/ontologies/virtualcoach#Meal"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">amount of Water</rdfs:label>
        <rdfs:label xml:lang="it">quantita&apos; Acqua</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#bounds -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#bounds">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#ViolationInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#command -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#command">
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>contains</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>hasCalories</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>notContains</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>portion</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#duration -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#duration">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Timespan"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#ediblePart -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#ediblePart">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Food"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label xml:lang="en">edible part</rdfs:label>
        <rdfs:label xml:lang="it">parte edibile</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasDailyCaloricIntake -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasDailyCaloricIntake">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#User"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasMETCorrection -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasMETCorrection">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#PerformedActivity"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasMETValue -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasMETValue">
        <rdfs:domain rdf:resource="http://www.fbk.eu/ontologies/virtualcoach#Activity"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.fbk.eu/ontologies/virtualcoach#hasOperator -->

    <owl:DatatypeProperty rdf:about="http://www.fbk.eu/ontologies/virtualcoach#hasOperator">
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>equal</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>greater</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>interval</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>less</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>percentage</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


